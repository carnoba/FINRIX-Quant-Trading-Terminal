# Institutional Macro-Gated Quantitative XAUUSD Forecasting Engine
# Environment variables for secure configuration
# 
# Never commit real secrets! Copy this file to .env and fill in actual values.
# This file is listed in .gitignore to prevent secrets leakage.

# ============================================================
# API Keys - Required for data fetching
# ============================================================
# FRED_API_KEY: US Federal Reserve Economic Data API key
# Get free key at: https://fred.stlouisfed.org/docs/api/fred/auth.html
FRED_API_KEY=your_fred_api_key_here

# MODAL_TOKEN: Authentication token for Modal GPU deployment
# Get at: https://modal.com/docs/reference/token
MODAL_TOKEN=your_modal_token_here

# Password required to access the Streamlit dashboard
DASHBOARD_PASSWORD=replace_with_a_strong_random_password

# ============================================================
# Optional API Keys
# ============================================================
# ALPHA_VANTAGE_KEY: For additional market datafeeds
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# ============================================================
# Model & Execution Configuration
# ============================================================
# FORECAST_HORIZON: "monthly" or "yearly"
FORECAST_HORIZON=monthly

# TFT Model parameters
TFT_HIDDEN_SIZE=64
TFT_LAGS=24
TFT_OUTPUT_SIZE=1

# FinBERT sentiment model
FINBERT_MODEL=ProsusAI/finbert

# FRED TIPS Yields series
FRED_SERIES_TIPS=TIPSYIELD

# ============================================================
# Execution & Risk
# ============================================================
# DEFAULT_TIMEFRAME for signal generation
DEFAULT_TIMEFRAME=M15

# Risk management
MAX_DRAWDOWN_PCT=2.0
MAX_POSITION_SIZE=0.1

# ============================================================
# CLI Mode
# ============================================================
# Supported modes: "monthly", "yearly"
MODE=monthly

# ============================================================
# MetaTrader 5 (if applicable)
# ============================================================
# MT5_LOGIN: MT5 terminal login ID
# MT5_PASSWORD: MT5 terminal password
# MT5_SERVER: Broker server name (e.g., "Exness-Trial")
# 
# These are used by dashboard.py and should NOT be committed.
# They are read from the runtime .env or system environment.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=